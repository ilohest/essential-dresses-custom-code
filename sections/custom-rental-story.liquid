{% liquid
  assign fact_blocks = section.blocks | where: 'type', 'fact'
  assign editorial_image_blocks = section.blocks | where: 'type', 'editorial_image'
  assign process_blocks = section.blocks | where: 'type', 'process'
  assign option_blocks = section.blocks | where: 'type', 'option'

  assign calendar_link = section.settings.calendar_link
  if calendar_link == blank
    assign calendar_link = '#appointo-modal-content'
  endif
%}


{% style %}
  #shopify-section-{{ section.id }} {
    --rental-spacing-top:
      calc(
        var(--section-spacing-unit-size) *
        {{ section.settings.spacing_top }}
      );

    --rental-spacing-bottom:
      calc(
        var(--section-spacing-unit-size) *
        {{ section.settings.spacing_bottom }}
      );
  }


  #shopify-section-{{ section.id }} > div {
    padding-block-start:
      var(--rental-spacing-top);

    padding-block-end:
      var(--rental-spacing-bottom);
  }


  /* ==========================================================================
     SMOOTH ANCHOR
     ========================================================================== */

  #appointo-modal-content {
    scroll-margin-top:
      calc(
        var(--header-height, 80px) +
        24px
      );
  }


  /* ==========================================================================
     GLOBAL
     ========================================================================== */

  #shopify-section-{{ section.id }} .rental-story {
    overflow: visible;
  }

  #shopify-section-{{ section.id }} .rental-story__container {
    display: flex;
    flex-direction: column;

    gap:
      clamp(100px, 11vw, 180px);
  }

  #shopify-section-{{ section.id }} .rental-story__eyebrow {
    margin:
      0
      0
      18px;

    font-size:
      clamp(0.82rem, 0.8vw, 0.95rem);

    line-height: 1.2;

    letter-spacing: 0.15em;

    text-transform: uppercase;

    opacity: 0.6;
  }

  #shopify-section-{{ section.id }} .rental-story__richtext {
    line-height: 1.65;
  }

  #shopify-section-{{ section.id }}
  .rental-story__richtext > *:first-child {
    margin-top: 0;
  }

  #shopify-section-{{ section.id }}
  .rental-story__richtext > *:last-child {
    margin-bottom: 0;
  }


  /* ==========================================================================
     INTRO
     ========================================================================== */

  #shopify-section-{{ section.id }} .rental-story__intro {
    display: grid;

    grid-template-columns:
      minmax(0, 1.2fr)
      minmax(340px, 0.8fr);

    gap:
      clamp(60px, 9vw, 150px);

    align-items: start;
  }

  #shopify-section-{{ section.id }} .rental-story__intro-main {
    max-width: 900px;
  }

  #shopify-section-{{ section.id }} .rental-story__intro-heading {
    max-width: 850px;

    margin:
      0
      0
      clamp(28px, 4vw, 46px);
  }

  #shopify-section-{{ section.id }} .rental-story__intro-text {
    max-width: 620px;
  }


  /* ==========================================================================
     PRACTICAL INFORMATION
     ========================================================================== */

  #shopify-section-{{ section.id }} .rental-story__facts {
    border-top:
      1px solid
      rgba(var(--color-foreground), 0.16);
  }

  #shopify-section-{{ section.id }} .rental-story__fact {
    display: grid;

    grid-template-columns:
      minmax(130px, 0.42fr)
      minmax(0, 1fr);

    gap: 28px;

    padding-block:
      clamp(24px, 2.5vw, 34px);

    border-bottom:
      1px solid
      rgba(var(--color-foreground), 0.16);
  }

  #shopify-section-{{ section.id }} .rental-story__fact-label {
    padding-top: 3px;

    font-size:
      clamp(0.84rem, 0.85vw, 1rem);

    line-height: 1.2;

    letter-spacing: 0.14em;

    text-transform: uppercase;

    opacity: 0.62;
  }

  #shopify-section-{{ section.id }} .rental-story__fact-value {
    font-size:
      clamp(1.12rem, 1.35vw, 1.4rem);

    line-height: 1.35;
  }


  /* ==========================================================================
     EDITORIAL GALLERY
     ========================================================================== */

  #shopify-section-{{ section.id }} .rental-story__gallery {
    width: 100%;
  }

  #shopify-section-{{ section.id }} .rental-story__gallery-grid {
    display: grid;

    grid-template-columns:
      repeat(12, minmax(0, 1fr));

    column-gap:
      clamp(18px, 3vw, 52px);

    row-gap:
      clamp(80px, 10vw, 160px);

    align-items: start;
  }

  #shopify-section-{{ section.id }} .rental-story__gallery-item {
    width: 100%;

    min-width: 0;

    margin: 0;
  }


  /* --------------------------------------------------------------------------
     Large
     -------------------------------------------------------------------------- */

  #shopify-section-{{ section.id }}
  .rental-story__gallery-item--large.rental-story__gallery-item--left {
    grid-column:
      1 / span 5;
  }

  #shopify-section-{{ section.id }}
  .rental-story__gallery-item--large.rental-story__gallery-item--center {
    grid-column:
      4 / span 6;
  }

  #shopify-section-{{ section.id }}
  .rental-story__gallery-item--large.rental-story__gallery-item--right {
    grid-column:
      8 / span 5;
  }


  /* --------------------------------------------------------------------------
     Medium
     -------------------------------------------------------------------------- */

  #shopify-section-{{ section.id }}
  .rental-story__gallery-item--medium.rental-story__gallery-item--left {
    grid-column:
      1 / span 4;
  }

  #shopify-section-{{ section.id }}
  .rental-story__gallery-item--medium.rental-story__gallery-item--center {
    grid-column:
      5 / span 4;
  }

  #shopify-section-{{ section.id }}
  .rental-story__gallery-item--medium.rental-story__gallery-item--right {
    grid-column:
      9 / span 4;
  }


  /* --------------------------------------------------------------------------
     Small
     -------------------------------------------------------------------------- */

  #shopify-section-{{ section.id }}
  .rental-story__gallery-item--small.rental-story__gallery-item--left {
    grid-column:
      1 / span 3;
  }

  #shopify-section-{{ section.id }}
  .rental-story__gallery-item--small.rental-story__gallery-item--center {
    grid-column:
      6 / span 3;
  }

  #shopify-section-{{ section.id }}
  .rental-story__gallery-item--small.rental-story__gallery-item--right {
    grid-column:
      10 / span 3;
  }


  /* --------------------------------------------------------------------------
     Rhythm
     -------------------------------------------------------------------------- */

  #shopify-section-{{ section.id }}
  .rental-story__gallery-item:nth-child(2n) {
    margin-top:
      clamp(24px, 4vw, 64px);
  }

  #shopify-section-{{ section.id }}
  .rental-story__gallery-item:nth-child(3n) {
    margin-top:
      clamp(8px, 2vw, 28px);
  }


  /* --------------------------------------------------------------------------
     Image
     -------------------------------------------------------------------------- */

  #shopify-section-{{ section.id }} .rental-story__gallery-image {
    width: 100%;

    aspect-ratio:
      var(--rental-gallery-ratio, 4 / 5);

    max-height:
      calc(
        100svh -
        var(--header-height, 80px) -
        80px
      );

    overflow: hidden;
  }

  #shopify-section-{{ section.id }}
  .rental-story__gallery-image img,

  #shopify-section-{{ section.id }}
  .rental-story__gallery-image svg {
    display: block;

    width: 100%;
    height: 100%;

    object-fit: cover;
  }

  #shopify-section-{{ section.id }} .rental-story__gallery-caption {
    margin-top: 12px;

    font-size: 0.85rem;
    line-height: 1.4;

    opacity: 0.52;
  }


  /* --------------------------------------------------------------------------
     Statement
     -------------------------------------------------------------------------- */

  #shopify-section-{{ section.id }} .rental-story__gallery-statement {
    max-width: 1000px;

    margin:
      clamp(100px, 12vw, 180px)
      auto
      0;

    text-align: center;
  }

  #shopify-section-{{ section.id }}
  .rental-story__gallery-statement-heading {
    margin: 0;

    text-wrap: balance;
  }


  /* ==========================================================================
     PROCESS
     ========================================================================== */

  #shopify-section-{{ section.id }} .rental-story__process {
    display: grid;

    grid-template-columns:
      minmax(300px, 0.72fr)
      minmax(0, 1.28fr);

    gap:
      clamp(70px, 9vw, 155px);

    align-items: start;
  }

  #shopify-section-{{ section.id }} .rental-story__process-head {
    position: sticky;

    top:
      calc(
        var(--header-height, 80px) +
        48px
      );

    align-self: start;
  }

  #shopify-section-{{ section.id }} .rental-story__process-heading {
    max-width: 520px;

    margin:
      0
      0
      30px;
  }

  #shopify-section-{{ section.id }} .rental-story__process-intro {
    max-width: 440px;
  }

  #shopify-section-{{ section.id }} .rental-story__steps {
    border-top:
      1px solid
      rgba(var(--color-foreground), 0.16);
  }

  #shopify-section-{{ section.id }} .rental-story__step {
    display: grid;

    grid-template-columns:
      72px
      minmax(0, 1fr);

    gap:
      clamp(18px, 3vw, 42px);

    padding-block:
      clamp(30px, 3.5vw, 48px);

    border-bottom:
      1px solid
      rgba(var(--color-foreground), 0.16);

    opacity: 0.25;

    transform:
      translateX(10px);

    transition:
      opacity 0.45s ease,
      transform 0.45s
      cubic-bezier(0.22, 1, 0.36, 1);
  }

  #shopify-section-{{ section.id }} .rental-story__step.is-active {
    opacity: 1;

    transform:
      translateX(0);
  }

  #shopify-section-{{ section.id }} .rental-story__step-number {
    padding-top: 7px;

    font-size:
      clamp(0.8rem, 0.8vw, 0.92rem);

    line-height: 1.2;

    letter-spacing: 0.14em;

    opacity: 0.55;
  }

  #shopify-section-{{ section.id }} .rental-story__step-heading {
    margin:
      0
      0
      14px;
  }

  #shopify-section-{{ section.id }} .rental-story__step-text {
    max-width: 680px;
  }


  /* ==========================================================================
     OPTIONS
     ========================================================================== */

  #shopify-section-{{ section.id }} .rental-story__options-head {
    display: grid;

    grid-template-columns:
      minmax(0, 0.8fr)
      minmax(0, 1.2fr);

    gap: 40px;

    align-items: end;

    margin-bottom:
      clamp(44px, 6vw, 80px);
  }

  #shopify-section-{{ section.id }} .rental-story__options-heading {
    margin: 0;
  }

  #shopify-section-{{ section.id }} .rental-story__options-intro {
    max-width: 560px;

    margin-left: auto;
  }


  /* --------------------------------------------------------------------------
     Grid
     -------------------------------------------------------------------------- */

  #shopify-section-{{ section.id }} .rental-story__options-grid {
    display: grid;

    grid-template-columns:
      repeat(
        {{ option_blocks.size | at_most: 3 }},
        minmax(0, 1fr)
      );

    gap:
      var(--grid-spacing);
  }


  /* --------------------------------------------------------------------------
     Card
     -------------------------------------------------------------------------- */

  #shopify-section-{{ section.id }} .rental-story__option {
    display: flex;
    flex-direction: column;

    min-height:
      clamp(360px, 38vw, 540px);

    padding:
      clamp(34px, 5vw, 68px);
  }

  #shopify-section-{{ section.id }} .rental-story__option-number {
    display: block;

    margin-bottom: auto;

    font-size:
      clamp(0.78rem, 0.75vw, 0.9rem);

    line-height: 1.2;

    letter-spacing: 0.14em;

    opacity: 0.55;
  }

  #shopify-section-{{ section.id }} .rental-story__option-content {
    max-width: 620px;
  }

  #shopify-section-{{ section.id }} .rental-story__option-heading {
    margin:
      0
      0
      20px;
  }

  #shopify-section-{{ section.id }} .rental-story__option-button {
    margin-top: 30px;
  }


  /* ==========================================================================
     CALENDAR TRANSITION
     ========================================================================== */

  #shopify-section-{{ section.id }} .rental-story__calendar-transition {
    display: flex;

    align-items: center;
    justify-content: center;

    min-height:
      clamp(360px, 48svh, 560px);

    padding:
      clamp(50px, 8vw, 100px);

    text-align: center;
  }

  #shopify-section-{{ section.id }} .rental-story__calendar-content {
    max-width: 920px;
  }

  #shopify-section-{{ section.id }} .rental-story__calendar-heading {
    margin:
      0
      0
      28px;

    text-wrap: balance;
  }

  #shopify-section-{{ section.id }} .rental-story__calendar-text {
    max-width: 620px;

    margin-inline: auto;
  }

  #shopify-section-{{ section.id }} .rental-story__calendar-arrow {
    display: flex;

    align-items: center;
    justify-content: center;

    width: 44px;
    height: 44px;

    margin:
      34px
      auto
      0;

    border:
      1px solid
      rgba(var(--color-foreground), 0.25);

    border-radius: 50%;

    color: inherit;

    font-size: 18px;
    line-height: 1;

    text-decoration: none;

    opacity: 0.7;

    cursor: pointer;

    transition:
      opacity 0.3s ease,
      transform 0.3s cubic-bezier(0.22, 1, 0.36, 1),
      border-color 0.3s ease;
  }


  /* ==========================================================================
     HOVER
     ========================================================================== */

  @media
    (hover: hover)
    and
    (prefers-reduced-motion: no-preference) {

    #shopify-section-{{ section.id }}
    .rental-story__gallery-image img {
      transition:
        transform
        0.8s
        cubic-bezier(0.22, 1, 0.36, 1);
    }

    #shopify-section-{{ section.id }}
    .rental-story__gallery-item:hover
    .rental-story__gallery-image img {
      transform:
        scale(1.025);
    }

    #shopify-section-{{ section.id }}
    .rental-story__calendar-arrow:hover {
      opacity: 1;

      transform:
        translateY(5px);

      border-color:
        rgba(var(--color-foreground), 0.5);
    }
  }


  /* ==========================================================================
     TABLET
     ========================================================================== */

  @media screen and (max-width: 989px) {

    #shopify-section-{{ section.id }} .rental-story__container {
      gap: 110px;
    }


    /* Intro */

    #shopify-section-{{ section.id }} .rental-story__intro {
      grid-template-columns: 1fr;

      gap: 56px;
    }

    #shopify-section-{{ section.id }} .rental-story__facts {
      max-width: 680px;
    }


    /* Process */

    #shopify-section-{{ section.id }} .rental-story__process {
      grid-template-columns: 1fr;

      gap: 48px;
    }

    #shopify-section-{{ section.id }} .rental-story__process-head {
      position: relative;

      top: auto;
    }

    #shopify-section-{{ section.id }} .rental-story__step {
      opacity: 1;

      transform: none;
    }


    /* Options */

    #shopify-section-{{ section.id }} .rental-story__options-grid {
      grid-template-columns:
        repeat(2, minmax(0, 1fr));
    }

  }


  /* ==========================================================================
     MOBILE
     ========================================================================== */

  @media screen and (max-width: 749px) {

    #shopify-section-{{ section.id }} .rental-story__container {
      gap: 84px;
    }


    /* ------------------------------------------------------------------------
       Intro
       ------------------------------------------------------------------------ */

    #shopify-section-{{ section.id }} .rental-story__fact {
      grid-template-columns: 1fr;

      gap: 8px;
    }

    #shopify-section-{{ section.id }} .rental-story__fact-value {
      font-size: inherit;
      line-height: 1.65;
    }


    /* ------------------------------------------------------------------------
       Gallery
       ------------------------------------------------------------------------ */

    #shopify-section-{{ section.id }} .rental-story__gallery-grid {
      grid-template-columns:
        repeat(12, minmax(0, 1fr));

      column-gap: 8px;

      row-gap: 68px;
    }


    /* Large */

    #shopify-section-{{ section.id }}
    .rental-story__gallery-item--large.rental-story__gallery-item--left {
      grid-column:
        1 / span 10;
    }

    #shopify-section-{{ section.id }}
    .rental-story__gallery-item--large.rental-story__gallery-item--center {
      grid-column:
        2 / span 10;
    }

    #shopify-section-{{ section.id }}
    .rental-story__gallery-item--large.rental-story__gallery-item--right {
      grid-column:
        3 / span 10;
    }


    /* Medium */

    #shopify-section-{{ section.id }}
    .rental-story__gallery-item--medium.rental-story__gallery-item--left {
      grid-column:
        1 / span 8;
    }

    #shopify-section-{{ section.id }}
    .rental-story__gallery-item--medium.rental-story__gallery-item--center {
      grid-column:
        3 / span 8;
    }

    #shopify-section-{{ section.id }}
    .rental-story__gallery-item--medium.rental-story__gallery-item--right {
      grid-column:
        5 / span 8;
    }


    /* Small */

    #shopify-section-{{ section.id }}
    .rental-story__gallery-item--small.rental-story__gallery-item--left {
      grid-column:
        1 / span 6;
    }

    #shopify-section-{{ section.id }}
    .rental-story__gallery-item--small.rental-story__gallery-item--center {
      grid-column:
        4 / span 6;
    }

    #shopify-section-{{ section.id }}
    .rental-story__gallery-item--small.rental-story__gallery-item--right {
      grid-column:
        7 / span 6;
    }

    #shopify-section-{{ section.id }}
    .rental-story__gallery-item:nth-child(2n) {
      margin-top: 26px;
    }

    #shopify-section-{{ section.id }}
    .rental-story__gallery-item:nth-child(3n) {
      margin-top: 0;
    }


    /* ------------------------------------------------------------------------
       Process
       ------------------------------------------------------------------------ */

    #shopify-section-{{ section.id }} .rental-story__step {
      grid-template-columns:
        38px
        minmax(0, 1fr);

      gap: 14px;

      padding-block: 28px;
    }


    /* ------------------------------------------------------------------------
       Options
       ------------------------------------------------------------------------ */

    #shopify-section-{{ section.id }} .rental-story__options-head {
      grid-template-columns: 1fr;

      gap: 24px;

      margin-bottom: 38px;
    }

    #shopify-section-{{ section.id }} .rental-story__options-intro {
      margin-left: 0;
    }

    #shopify-section-{{ section.id }} .rental-story__options-grid {
      grid-template-columns: 1fr;

      gap: 12px;
    }

    #shopify-section-{{ section.id }} .rental-story__option {
      min-height: 360px;

      padding:
        36px
        26px;
    }


    /* ------------------------------------------------------------------------
       Calendar
       ------------------------------------------------------------------------ */

    #shopify-section-{{ section.id }} .rental-story__calendar-transition {
      min-height: 400px;

      padding:
        56px
        24px;
    }

  }
{% endstyle %}



<div class="color-{{ section.settings.color_scheme }} gradient">

  <div
    class="
      rental-story
      container
      {{ section.settings.section_width }}
      js-animation-fade-in
    "
  >

    <div class="rental-story__container">


      {%- comment -%}
        ================================================================
        INTRO
        ================================================================
      {%- endcomment -%}

      <section class="rental-story__intro">

        <div class="rental-story__intro-main">

          {% if section.settings.intro_eyebrow != blank %}

            <p class="rental-story__eyebrow">
              {{ section.settings.intro_eyebrow }}
            </p>

          {% endif %}


          {% if section.settings.intro_heading != blank %}

            <h2 class="rental-story__intro-heading {{ section.settings.intro_heading_size }}">
              {{ section.settings.intro_heading }}
            </h2>

          {% endif %}


          {% if section.settings.intro_text != blank %}

            <div class="rental-story__intro-text rental-story__richtext rte">
              {{ section.settings.intro_text }}
            </div>

          {% endif %}

        </div>


        {% if fact_blocks.size > 0 %}

          <div class="rental-story__facts">

            {% for block in fact_blocks %}

              <div
                class="rental-story__fact"
                {{ block.shopify_attributes }}
              >

                {% if block.settings.label != blank %}

                  <span class="rental-story__fact-label">
                    {{ block.settings.label }}
                  </span>

                {% endif %}


                {% if block.settings.value != blank %}

                  <span class="rental-story__fact-value">
                    {{ block.settings.value }}
                  </span>

                {% endif %}

              </div>

            {% endfor %}

          </div>

        {% endif %}

      </section>



      {%- comment -%}
        ================================================================
        EDITORIAL GALLERY
        ================================================================
      {%- endcomment -%}

      {% if editorial_image_blocks.size > 0 %}

        <section class="rental-story__gallery">

          <div class="rental-story__gallery-grid">

            {% for block in editorial_image_blocks %}

              <figure
                class="
                  rental-story__gallery-item
                  rental-story__gallery-item--{{ block.settings.size }}
                  rental-story__gallery-item--{{ block.settings.alignment }}
                "
                {{ block.shopify_attributes }}
              >

                {% if block.settings.image != blank %}

                  <div
                    class="rental-story__gallery-image"
                    style="
                      --rental-gallery-ratio:
                        {{ block.settings.aspect_ratio }};
                    "
                  >

                    {% render 'image',
                      image: block.settings.image,
                      section_index: section.index,
                      image_per_view: 3
                    %}

                  </div>

                {% endif %}


                {% if block.settings.caption != blank %}

                  <figcaption class="rental-story__gallery-caption">
                    {{ block.settings.caption }}
                  </figcaption>

                {% endif %}

              </figure>

            {% endfor %}

          </div>


          {% if section.settings.gallery_heading != blank %}

            <div class="rental-story__gallery-statement">

              <h2 class="rental-story__gallery-statement-heading {{ section.settings.gallery_heading_size }}">
                {{ section.settings.gallery_heading }}
              </h2>

            </div>

          {% endif %}

        </section>

      {% endif %}



      {%- comment -%}
        ================================================================
        PROCESS
        ================================================================
      {%- endcomment -%}

      {% if process_blocks.size > 0 %}

        <section class="rental-story__process">

          <div class="rental-story__process-head">

            {% if section.settings.process_eyebrow != blank %}

              <p class="rental-story__eyebrow">
                {{ section.settings.process_eyebrow }}
              </p>

            {% endif %}


            {% if section.settings.process_heading != blank %}

              <h2 class="rental-story__process-heading {{ section.settings.process_heading_size }}">
                {{ section.settings.process_heading }}
              </h2>

            {% endif %}


            {% if section.settings.process_text != blank %}

              <div class="rental-story__process-intro rental-story__richtext rte">
                {{ section.settings.process_text }}
              </div>

            {% endif %}

          </div>


          <div class="rental-story__steps">

            {% for block in process_blocks %}

              <article
                class="rental-story__step"
                {{ block.shopify_attributes }}
              >

                <span class="rental-story__step-number">

                  {% if block.settings.number != blank %}
                    {{ block.settings.number }}
                  {% else %}
                    0{{ forloop.index }}
                  {% endif %}

                </span>


                <div>

                  {% if block.settings.heading != blank %}

                    <h3 class="rental-story__step-heading {{ block.settings.heading_size }}">
                      {{ block.settings.heading }}
                    </h3>

                  {% endif %}


                  {% if block.settings.text != blank %}

                    <div class="rental-story__step-text rental-story__richtext rte">
                      {{ block.settings.text }}
                    </div>

                  {% endif %}

                </div>

              </article>

            {% endfor %}

          </div>

        </section>

      {% endif %}



      {%- comment -%}
