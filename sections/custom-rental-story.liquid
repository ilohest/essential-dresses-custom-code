                  {% else %}
                    0{{ forloop.index }}
                  {% endif %}

                </span>


                <div class="rental-story__option-content">

                  {% if block.settings.heading != blank %}

                    <h3 class="rental-story__option-heading {{ block.settings.heading_size }}">
                      {{ block.settings.heading }}
                    </h3>

                  {% endif %}


                  {% if block.settings.text != blank %}

