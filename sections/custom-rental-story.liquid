<script>
  (() => {
    const section =
      document.querySelector(
        '#shopify-section-{{ section.id }}'
      );

    if (!section) return;


    /* ========================================================================
       SMOOTH SCROLL TO APPOINTMENT
       ======================================================================== */

    const appointmentHash =
      '#appointo-modal-content';


    const appointmentLinks =
      section.querySelectorAll(
        `a[href*="${appointmentHash}"]`
      );


    appointmentLinks.forEach((link) => {

      link.addEventListener(
        'click',
        (event) => {

          const target =
            document.querySelector(
              appointmentHash
            );


          if (!target) {
            return;
          }


          const linkUrl =
            new URL(
              link.href,
              window.location.href
            );


          const currentUrl =
            new URL(
              window.location.href
            );


          const isCurrentPage =
            linkUrl.origin === currentUrl.origin &&
            linkUrl.pathname === currentUrl.pathname;


          if (!isCurrentPage) {
            return;
          }


          event.preventDefault();


          const reduceMotion =
            window.matchMedia(
              '(prefers-reduced-motion: reduce)'
            ).matches;


          target.scrollIntoView({
            behavior:
              reduceMotion
                ? 'auto'
                : 'smooth',

            block:
              'start'
          });


          if (
            window.location.hash !==
            appointmentHash
          ) {

            history.pushState(
              null,
              '',
              appointmentHash
            );

          }

        }
      );

    });



    const process =
      section.querySelector(
        '.rental-story__process'
      );


    const steps =
      section.querySelectorAll(
        '.rental-story__step'
      );


    if (
      !process ||
      !steps.length
    ) {
      return;
    }


    /* ========================================================================
       ACTIVE PROCESS STEP
       ======================================================================== */

    const setActiveStep = () => {

      if (window.innerWidth < 990) {

        steps.forEach((step) => {

          step.classList.add(
            'is-active'
          );

        });

        return;
      }


      const processRect =
        process.getBoundingClientRect();


      if (
        processRect.bottom < 0 ||
        processRect.top > window.innerHeight
      ) {
        return;
      }


      const target =
        window.innerHeight * 0.46;


      let closestStep =
        null;


      let closestDistance =
        Infinity;


      steps.forEach((step) => {

        const rect =
          step.getBoundingClientRect();


        const center =
          rect.top +
          rect.height / 2;


        const distance =
          Math.abs(
            center -
            target
          );


        if (
          distance <
          closestDistance
        ) {

          closestDistance =
            distance;

          closestStep =
            step;

        }

      });


      steps.forEach((step) => {

        step.classList.toggle(
          'is-active',
          step === closestStep
        );

      });

    };


    let ticking =
      false;


    const handleScroll = () => {

      if (ticking) return;


      ticking =
        true;


      requestAnimationFrame(() => {

        setActiveStep();

        ticking =
          false;

      });

    };


    setActiveStep();


    window.addEventListener(
      'scroll',
      handleScroll,
      {
        passive: true
      }
    );


    window.addEventListener(
      'resize',
      setActiveStep,
      {
        passive: true
      }
    );


    /* ========================================================================
       SHOPIFY EDITOR
       ======================================================================== */

    if (
      typeof Shopify !== 'undefined' &&
      Shopify.designMode
    ) {

      document.addEventListener(
        'shopify:block:select',
        setActiveStep
      );


      document.addEventListener(
        'shopify:section:load',
        setActiveStep
      );

    }
  })();
</script>



