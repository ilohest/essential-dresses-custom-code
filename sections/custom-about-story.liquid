<script>
  (() => {
    const section =
      document.querySelector(
        '#shopify-section-{{ section.id }}'
      );

    if (!section) return;


    const track =
      section.querySelector(
        '.about-story__horizontal-track'
      );

    const sticky =
      section.querySelector(
        '.about-story__horizontal-sticky'
      );

    const scroller =
      section.querySelector(
        '.about-story__scroller'
      );

    const nextButton =
      section.querySelector(
        '.about-story__slider-next'
      );


    if (
      !track ||
      !sticky ||
      !scroller
    ) {
      return;
    }


    let maxHorizontalScroll = 0;
    let scrollDistance = 0;
    let trackStart = 0;

    let ticking = false;
    let resizeTimeout = null;


    /* ========================================================================
       Helpers
       ======================================================================== */

    const clamp = (
      value,
      min,
      max
    ) => {
      return Math.min(
        Math.max(value, min),
        max
      );
    };


    const getHeaderHeight = () => {
      const value =
        getComputedStyle(section)
          .getPropertyValue(
            '--about-header-height'
          );

      return parseFloat(value) || 80;
    };


    /* ========================================================================
       Desktop horizontal position
       ======================================================================== */

    const updateHorizontalScroll = () => {
      ticking = false;


      if (window.innerWidth < 990) {
        return;
      }


      if (
        maxHorizontalScroll <= 0 ||
        scrollDistance <= 0
      ) {
        scroller.style.setProperty(
          '--about-horizontal-x',
          '0px'
        );

        return;
      }


      const progress =
        clamp(
          (
            window.scrollY -
            trackStart
          ) /
          scrollDistance,
          0,
          1
        );


      const translateX =
        -maxHorizontalScroll *
        progress;


      scroller.style.setProperty(
        '--about-horizontal-x',
        `${translateX}px`
      );
    };


    /* ========================================================================
       Mobile next button
       ======================================================================== */

    const updateNextButton = () => {
      if (!nextButton) {
        return;
      }


      /*
       * La flèche n'est utile que sur tablette/mobile.
       */
      if (window.innerWidth >= 990) {
        nextButton.classList.remove(
          'is-hidden'
        );

        return;
      }


      const maxScroll =
        Math.max(
          0,
          scroller.scrollWidth -
          scroller.clientWidth
        );


      /*
       * Pas de contenu à faire défiler :
       * on masque la flèche.
       */
      if (maxScroll <= 1) {
        nextButton.classList.add(
          'is-hidden'
        );

        return;
      }


      const isAtEnd =
        scroller.scrollLeft >=
        maxScroll - 10;


      nextButton.classList.toggle(
        'is-hidden',
        isAtEnd
      );
    };


    const scrollToNextCard = () => {
      if (window.innerWidth >= 990) {
        return;
      }


      const cards =
        scroller.querySelectorAll(
          '.about-story__pillar'
        );


      if (!cards.length) {
        return;
      }


      /*
       * On cherche la première carte située
       * réellement après le bord gauche visible.
       *
       * C'est plus robuste qu'un scrollBy fixe
       * si les cartes changent de largeur.
       */
      const currentScroll =
        scroller.scrollLeft;


      let targetScroll = null;


      cards.forEach((card) => {
        if (targetScroll !== null) {
          return;
        }


        const cardLeft =
          card.offsetLeft;


        if (
          cardLeft >
          currentScroll + 10
        ) {
          targetScroll =
            cardLeft;
        }
      });


      /*
       * Fallback :
       * si aucune carte suivante n'est trouvée,
       * on va jusqu'à la fin.
       */
      if (targetScroll === null) {
        targetScroll =
          scroller.scrollWidth -
          scroller.clientWidth;
      }


      scroller.scrollTo({
        left: targetScroll,
        behavior: 'smooth'
      });
    };


    /* ========================================================================
       Dimensions
       ======================================================================== */

    const calculateDimensions = () => {

      /*
       * Mobile / tablette :
       * le carousel reste natif.
       */
      if (window.innerWidth < 990) {

        track.style.height = '';

        scroller.style.removeProperty(
          '--about-horizontal-x'
        );


        updateNextButton();

        return;
      }


      /*
       * Desktop :
       * on repart proprement du mode natif.
       */
      scroller.scrollLeft = 0;


      const stickyWidth =
        sticky.clientWidth;


      const stickyHeight =
        sticky.clientHeight;


      /*
       * Distance horizontale totale.
       */
      maxHorizontalScroll =
        Math.max(
          0,
          scroller.scrollWidth -
          stickyWidth
        );


      /*
       * 1px vertical ≈ 1px horizontal.
       */
      scrollDistance =
        maxHorizontalScroll;


      /*
       * Hauteur nécessaire pour maintenir
       * la zone sticky pendant tout le mouvement.
       */
      track.style.height =
        `${
          stickyHeight +
          scrollDistance
        }px`;


      /*
       * Position absolue du début du track.
       */
      const trackRect =
        track.getBoundingClientRect();


      trackStart =
        window.scrollY +
        trackRect.top -
        getHeaderHeight();


      updateHorizontalScroll();
      updateNextButton();
    };


    /* ========================================================================
       Events
       ======================================================================== */

    const handleScroll = () => {

      if (ticking) return;


      ticking = true;


      requestAnimationFrame(
        updateHorizontalScroll
      );
    };


    const handleScrollerScroll = () => {

      /*
       * Seulement utile pour le carousel natif mobile.
       */
      if (window.innerWidth >= 990) {
        return;
      }


      requestAnimationFrame(
        updateNextButton
      );
    };


    const handleResize = () => {

      clearTimeout(
        resizeTimeout
      );


      resizeTimeout =
        setTimeout(
          calculateDimensions,
          150
        );
    };


    /* ========================================================================
       Button event
       ======================================================================== */

    if (nextButton) {

      nextButton.addEventListener(
        'click',
        scrollToNextCard
      );

    }


    /* ========================================================================
       Init
       ======================================================================== */

    calculateDimensions();


    window.addEventListener(
      'scroll',
      handleScroll,
      {
        passive: true
      }
    );


    scroller.addEventListener(
      'scroll',
      handleScrollerScroll,
      {
        passive: true
      }
    );


    window.addEventListener(
      'resize',
      handleResize,
      {
        passive: true
      }
    );


    /*
     * Recalcul une fois toutes les images chargées.
     */
    window.addEventListener(
      'load',
      () => {
        calculateDimensions();
        updateNextButton();
      },
      {
        once: true
      }
    );


    /* ========================================================================
       Shopify Theme Editor
       ======================================================================== */

    if (
      typeof Shopify !== 'undefined' &&
      Shopify.designMode
    ) {

      document.addEventListener(
        'shopify:block:select',
        calculateDimensions
      );


      document.addEventListener(
        'shopify:section:load',
        calculateDimensions
      );

    }
  })();
</script>


