<script>
  (() => {
    const section =
      document.querySelector(
        '#shopify-section-{{ section.id }}'
      );

    if (!section) return;


    const process =
      section.querySelector(
        '.custom-made__process'
      );


    const steps =
      section.querySelectorAll(
        '.custom-made__step'
      );


    if (
      !process ||
      !steps.length
    ) {
      return;
    }


    const setActiveStep = () => {

      if (window.innerWidth < 990) {

        steps.forEach((step) => {

          step.classList.add(
            'is-active'
          );

        });

        return;
      }


      const processRect =
        process.getBoundingClientRect();


      if (
        processRect.bottom < 0 ||
        processRect.top > window.innerHeight
      ) {
        return;
      }


      const target =
        window.innerHeight * 0.46;


      let closestStep =
        null;


      let closestDistance =
        Infinity;


      steps.forEach((step) => {

        const rect =
          step.getBoundingClientRect();


        const center =
          rect.top +
          rect.height / 2;


        const distance =
          Math.abs(
            center -
            target
          );


        if (
          distance <
          closestDistance
        ) {

          closestDistance =
            distance;

          closestStep =
            step;

        }

      });


      steps.forEach((step) => {

        step.classList.toggle(
          'is-active',
          step === closestStep
        );

      });

    };


    let ticking =
      false;


    const handleScroll = () => {

      if (ticking) return;


      ticking =
        true;


      requestAnimationFrame(() => {

        setActiveStep();

        ticking =
          false;

      });

    };


    setActiveStep();


    window.addEventListener(
      'scroll',
      handleScroll,
      {
        passive: true
      }
    );


    window.addEventListener(
      'resize',
      setActiveStep,
      {
        passive: true
      }
    );


    if (
      typeof Shopify !== 'undefined' &&
      Shopify.designMode
    ) {

      document.addEventListener(
        'shopify:block:select',
        setActiveStep
      );


      document.addEventListener(
        'shopify:section:load',
        setActiveStep
      );

    }
  })();
</script>



