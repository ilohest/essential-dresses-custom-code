{% liquid
  assign fact_blocks = section.blocks | where: 'type', 'fact'
  assign editorial_image_blocks = section.blocks | where: 'type', 'editorial_image'
  assign process_blocks = section.blocks | where: 'type', 'process'
  assign expertise_blocks = section.blocks | where: 'type', 'expertise'
%}


{% style %}
  #shopify-section-{{ section.id }} {
    --custom-made-spacing-top:
      calc(
        var(--section-spacing-unit-size) *
        {{ section.settings.spacing_top }}
      );

    --custom-made-spacing-bottom:
      calc(
        var(--section-spacing-unit-size) *
        {{ section.settings.spacing_bottom }}
      );
  }


  #shopify-section-{{ section.id }} > div {
    padding-block-start:
      var(--custom-made-spacing-top);

    padding-block-end:
      var(--custom-made-spacing-bottom);
  }


  /* ==========================================================================
     GLOBAL
     ========================================================================== */

  #shopify-section-{{ section.id }} .custom-made {
    overflow: visible;
  }

  #shopify-section-{{ section.id }} .custom-made__container {
    display: flex;
    flex-direction: column;

    gap:
      clamp(100px, 11vw, 180px);
  }

  #shopify-section-{{ section.id }} .custom-made__eyebrow {
    margin:
      0
      0
      18px;

    font-size:
      clamp(0.82rem, 0.8vw, 0.95rem);

    line-height: 1.2;

    letter-spacing: 0.15em;

    text-transform: uppercase;

    opacity: 0.6;
  }

  #shopify-section-{{ section.id }} .custom-made__richtext {
    line-height: 1.65;
  }

  #shopify-section-{{ section.id }}
  .custom-made__richtext > *:first-child {
    margin-top: 0;
  }

  #shopify-section-{{ section.id }}
  .custom-made__richtext > *:last-child {
    margin-bottom: 0;
  }


  /* ==========================================================================
     INTRO
     ========================================================================== */

  #shopify-section-{{ section.id }} .custom-made__intro {
    display: grid;

    grid-template-columns:
      minmax(0, 1.25fr)
      minmax(340px, 0.75fr);

    gap:
      clamp(60px, 9vw, 150px);

    align-items: start;
  }

  #shopify-section-{{ section.id }} .custom-made__intro-main {
    max-width: 900px;
  }

  #shopify-section-{{ section.id }} .custom-made__intro-heading {
    max-width: 850px;

    margin:
      0
      0
      clamp(28px, 4vw, 46px);
  }

  #shopify-section-{{ section.id }} .custom-made__intro-text {
    max-width: 600px;
  }

  #shopify-section-{{ section.id }} .custom-made__intro-button {
    margin-top: 32px;
  }


  /* ==========================================================================
     ESSENTIAL INFORMATION
     ========================================================================== */

  #shopify-section-{{ section.id }} .custom-made__facts {
    border-top:
      1px solid
      rgba(var(--color-foreground), 0.16);
  }

  #shopify-section-{{ section.id }} .custom-made__fact {
    display: grid;

    grid-template-columns:
      minmax(130px, 0.42fr)
      minmax(0, 1fr);

    gap: 28px;

    padding-block:
      clamp(24px, 2.5vw, 34px);

    border-bottom:
      1px solid
      rgba(var(--color-foreground), 0.16);
  }

  #shopify-section-{{ section.id }} .custom-made__fact-label {
    padding-top: 3px;

    font-size:
      clamp(0.84rem, 0.85vw, 1rem);

    line-height: 1.2;

    letter-spacing: 0.14em;

    text-transform: uppercase;

    opacity: 0.62;
  }

  #shopify-section-{{ section.id }} .custom-made__fact-value {
    font-size:
      clamp(1.12rem, 1.35vw, 1.4rem);

    line-height: 1.35;
  }


  /* ==========================================================================
     EDITORIAL GALLERY
     ========================================================================== */

  #shopify-section-{{ section.id }} .custom-made__editorial {
    width: 100%;
  }


  /*
   * Grille volontairement très aérée.
   *
   * On ne mélange plus grid-column: span avec grid-column-start.
   * Chaque combinaison taille + alignement possède une position complète.
   */
  #shopify-section-{{ section.id }} .custom-made__editorial-gallery {
    display: grid;

    grid-template-columns:
      repeat(12, minmax(0, 1fr));

    column-gap:
      clamp(18px, 3vw, 52px);

    row-gap:
      clamp(80px, 10vw, 160px);

    align-items: start;
  }

  #shopify-section-{{ section.id }} .custom-made__editorial-item {
    width: 100%;

    min-width: 0;

    margin: 0;
  }


  /* --------------------------------------------------------------------------
     LARGE
     -------------------------------------------------------------------------- */

  #shopify-section-{{ section.id }}
  .custom-made__editorial-item--large.custom-made__editorial-item--left {
    grid-column:
      1 / span 5;
  }

  #shopify-section-{{ section.id }}
  .custom-made__editorial-item--large.custom-made__editorial-item--center {
    grid-column:
      4 / span 6;
  }

  #shopify-section-{{ section.id }}
  .custom-made__editorial-item--large.custom-made__editorial-item--right {
    grid-column:
      8 / span 5;
  }


  /* --------------------------------------------------------------------------
     MEDIUM
     -------------------------------------------------------------------------- */

  #shopify-section-{{ section.id }}
  .custom-made__editorial-item--medium.custom-made__editorial-item--left {
    grid-column:
      1 / span 4;
  }

  #shopify-section-{{ section.id }}
  .custom-made__editorial-item--medium.custom-made__editorial-item--center {
    grid-column:
      5 / span 4;
  }

  #shopify-section-{{ section.id }}
  .custom-made__editorial-item--medium.custom-made__editorial-item--right {
    grid-column:
      9 / span 4;
  }


  /* --------------------------------------------------------------------------
     SMALL
     -------------------------------------------------------------------------- */

  #shopify-section-{{ section.id }}
  .custom-made__editorial-item--small.custom-made__editorial-item--left {
    grid-column:
      1 / span 3;
  }

  #shopify-section-{{ section.id }}
  .custom-made__editorial-item--small.custom-made__editorial-item--center {
    grid-column:
      6 / span 3;
  }

  #shopify-section-{{ section.id }}
  .custom-made__editorial-item--small.custom-made__editorial-item--right {
    grid-column:
      10 / span 3;
  }


  /* --------------------------------------------------------------------------
     Vertical rhythm
     -------------------------------------------------------------------------- */

  #shopify-section-{{ section.id }}
  .custom-made__editorial-item:nth-child(2n) {
    margin-top:
      clamp(30px, 4vw, 70px);
  }

  #shopify-section-{{ section.id }}
  .custom-made__editorial-item:nth-child(3n) {
    margin-top:
      clamp(10px, 2vw, 32px);
  }


  /* --------------------------------------------------------------------------
     Image
     -------------------------------------------------------------------------- */

  #shopify-section-{{ section.id }} .custom-made__editorial-image {
    width: 100%;

    aspect-ratio:
      var(--editorial-ratio, 4 / 5);

    max-height:
      calc(
        100svh -
        var(--header-height, 80px) -
        80px
      );

    overflow: hidden;
  }

  #shopify-section-{{ section.id }}
  .custom-made__editorial-image img,

  #shopify-section-{{ section.id }}
  .custom-made__editorial-image svg {
    display: block;

    width: 100%;
    height: 100%;

    object-fit: cover;
  }


  /* --------------------------------------------------------------------------
     Caption
     -------------------------------------------------------------------------- */

  #shopify-section-{{ section.id }} .custom-made__editorial-caption {
    margin-top: 12px;

    font-size: 0.85rem;

    line-height: 1.4;

    opacity: 0.52;
  }


  /* --------------------------------------------------------------------------
     Manifesto
     -------------------------------------------------------------------------- */

  #shopify-section-{{ section.id }} .custom-made__manifesto {
    max-width: 1100px;

    margin:
      clamp(100px, 12vw, 180px)
      auto
      0;
  }

  #shopify-section-{{ section.id }} .custom-made__manifesto-heading {
    margin: 0;

    text-align: center;

    text-wrap: balance;
  }


  /* ==========================================================================
     PROCESS
     ========================================================================== */

  #shopify-section-{{ section.id }} .custom-made__process {
    display: grid;

    grid-template-columns:
      minmax(300px, 0.72fr)
      minmax(0, 1.28fr);

    gap:
      clamp(70px, 9vw, 155px);

    align-items: start;
  }


  /* --------------------------------------------------------------------------
     Sticky heading
     -------------------------------------------------------------------------- */

  #shopify-section-{{ section.id }} .custom-made__process-head {
    position: sticky;

    top:
      calc(
        var(--header-height, 80px) +
        48px
      );

    align-self: start;
  }

  #shopify-section-{{ section.id }} .custom-made__process-heading {
    max-width: 520px;

    margin:
      0
      0
      30px;
  }

  #shopify-section-{{ section.id }} .custom-made__process-intro {
    max-width: 440px;
  }


  /* --------------------------------------------------------------------------
     Steps
     -------------------------------------------------------------------------- */

  #shopify-section-{{ section.id }} .custom-made__steps {
    border-top:
      1px solid
      rgba(var(--color-foreground), 0.16);
  }

  #shopify-section-{{ section.id }} .custom-made__step {
    display: grid;

    grid-template-columns:
      72px
      minmax(0, 1fr);

    gap:
      clamp(18px, 3vw, 42px);

    padding-block:
      clamp(30px, 3.5vw, 48px);

    border-bottom:
      1px solid
      rgba(var(--color-foreground), 0.16);

    opacity: 0.25;

    transform:
      translateX(10px);

    transition:
      opacity 0.45s ease,
      transform 0.45s
      cubic-bezier(0.22, 1, 0.36, 1);
  }

  #shopify-section-{{ section.id }} .custom-made__step.is-active {
    opacity: 1;

    transform:
      translateX(0);
  }

  #shopify-section-{{ section.id }} .custom-made__step-number {
    padding-top: 7px;

    font-size:
      clamp(0.8rem, 0.8vw, 0.92rem);

    line-height: 1.2;

    letter-spacing: 0.14em;

    opacity: 0.55;
  }

  #shopify-section-{{ section.id }} .custom-made__step-heading {
    margin:
      0
      0
      14px;
  }

  #shopify-section-{{ section.id }} .custom-made__step-text {
    max-width: 680px;
  }


  /* ==========================================================================
     SPECIAL PROJECT
     ========================================================================== */

  #shopify-section-{{ section.id }} .custom-made__special {
    display: grid;

    grid-template-columns:
      minmax(0, 0.8fr)
      minmax(0, 1.2fr);

    gap:
      clamp(50px, 8vw, 120px);

    padding:
      clamp(42px, 7vw, 90px);
  }

  #shopify-section-{{ section.id }} .custom-made__special-heading {
    margin: 0;
  }

  #shopify-section-{{ section.id }} .custom-made__special-content {
    max-width: 680px;
  }

  #shopify-section-{{ section.id }} .custom-made__special-button {
    margin-top: 28px;
  }


  /* ==========================================================================
     EXPERTISE
     ========================================================================== */

  #shopify-section-{{ section.id }} .custom-made__expertise-head {
    display: grid;

    grid-template-columns:
      minmax(0, 0.8fr)
      minmax(0, 1.2fr);

    gap: 40px;

    align-items: end;

    margin-bottom:
      clamp(44px, 6vw, 80px);
  }

  #shopify-section-{{ section.id }} .custom-made__expertise-heading {
    margin: 0;
  }

  #shopify-section-{{ section.id }} .custom-made__expertise-intro {
    max-width: 560px;

    margin-left: auto;
  }

  #shopify-section-{{ section.id }} .custom-made__expertise-grid {
    display: grid;

    grid-template-columns:
      repeat(4, minmax(0, 1fr));

    gap:
      clamp(18px, 2vw, 34px);
  }

  #shopify-section-{{ section.id }} .custom-made__expertise-card {
    min-width: 0;
  }

  #shopify-section-{{ section.id }} .custom-made__expertise-media {
    width: 100%;

    aspect-ratio: 4 / 5;

    max-height: 420px;

    overflow: hidden;

    background:
      rgba(var(--color-foreground), 0.035);
  }

  #shopify-section-{{ section.id }} .custom-made__expertise-media img,
  #shopify-section-{{ section.id }} .custom-made__expertise-media svg {
    display: block;

    width: 100%;
    height: 100%;

    object-fit: cover;
  }

  #shopify-section-{{ section.id }} .custom-made__expertise-content {
    padding-top:
      clamp(18px, 2vw, 26px);
  }

  #shopify-section-{{ section.id }} .custom-made__expertise-number {
    display: block;

    margin-bottom: 10px;

    font-size: 0.75rem;

    letter-spacing: 0.12em;

    opacity: 0.45;
  }

  #shopify-section-{{ section.id }} .custom-made__expertise-card-heading {
    margin: 0;
  }

  #shopify-section-{{ section.id }} .custom-made__expertise-text {
    margin-top: 14px;

    font-size: 0.95em;

    opacity: 0.65;
  }


  /* ==========================================================================
     FINAL CTA
     ========================================================================== */

  #shopify-section-{{ section.id }} .custom-made__cta {
    position: relative;

    display: flex;

    align-items: center;
    justify-content: center;

    min-height:
      clamp(420px, 58svh, 660px);

    padding:
      clamp(50px, 8vw, 110px);

    overflow: hidden;

    text-align: center;

    isolation: isolate;
  }

  #shopify-section-{{ section.id }} .custom-made__cta-media {
    position: absolute;

    inset: 0;

    z-index: -2;
  }

  #shopify-section-{{ section.id }} .custom-made__cta-media img,
  #shopify-section-{{ section.id }} .custom-made__cta-media svg {
    display: block;

    width: 100%;
    height: 100%;

    object-fit: cover;

    object-position:
      var(--cta-image-position, center);
  }

  #shopify-section-{{ section.id }} .custom-made__cta-overlay {
    position: absolute;

    inset: 0;

    z-index: -1;

    background:
      rgba(
        {{ section.settings.cta_overlay_color.red }},
        {{ section.settings.cta_overlay_color.green }},
        {{ section.settings.cta_overlay_color.blue }},
        {{ section.settings.cta_overlay_opacity | divided_by: 100.0 }}
      );

    pointer-events: none;
  }

  #shopify-section-{{ section.id }} .custom-made__cta-content {
    position: relative;

    z-index: 1;

    max-width: 1100px;
  }

  #shopify-section-{{ section.id }} .custom-made__cta-heading {
    margin: 0;

    text-wrap: balance;
  }

  #shopify-section-{{ section.id }} .custom-made__cta-button {
    display: flex;

    justify-content: center;

    margin-top:
      clamp(30px, 4vw, 44px);
  }


  /* ==========================================================================
     HOVER
     ========================================================================== */

  @media
    (hover: hover)
    and
    (prefers-reduced-motion: no-preference) {

    #shopify-section-{{ section.id }}
    .custom-made__editorial-image img,

    #shopify-section-{{ section.id }}
    .custom-made__expertise-media img {
      transition:
        transform
        0.8s
        cubic-bezier(0.22, 1, 0.36, 1);
    }

    #shopify-section-{{ section.id }}
    .custom-made__editorial-item:hover
    .custom-made__editorial-image img,

    #shopify-section-{{ section.id }}
    .custom-made__expertise-card:hover
    .custom-made__expertise-media img {
      transform:
        scale(1.025);
    }
  }


  /* ==========================================================================
     TABLET
     ========================================================================== */

  @media screen and (max-width: 989px) {

    #shopify-section-{{ section.id }} .custom-made__container {
      gap: 110px;
    }


    /* Intro */

    #shopify-section-{{ section.id }} .custom-made__intro {
      grid-template-columns: 1fr;

      gap: 56px;
    }

    #shopify-section-{{ section.id }} .custom-made__facts {
      max-width: 680px;
    }


    /* Process */

    #shopify-section-{{ section.id }} .custom-made__process {
      grid-template-columns: 1fr;

      gap: 48px;
    }

    #shopify-section-{{ section.id }} .custom-made__process-head {
      position: relative;

      top: auto;
    }

    #shopify-section-{{ section.id }} .custom-made__step {
      opacity: 1;

      transform: none;
    }


    /* Special */

    #shopify-section-{{ section.id }} .custom-made__special {
      grid-template-columns: 1fr;

      gap: 32px;
    }


    /* Expertise */

    #shopify-section-{{ section.id }} .custom-made__expertise-grid {
      grid-template-columns:
        repeat(2, minmax(0, 1fr));

      gap:
        50px
        24px;
    }

  }


  /* ==========================================================================
     MOBILE
     ========================================================================== */

  @media screen and (max-width: 749px) {

    #shopify-section-{{ section.id }} .custom-made__container {
      gap: 84px;
    }


    /* ------------------------------------------------------------------------
       Intro
       ------------------------------------------------------------------------ */

    #shopify-section-{{ section.id }} .custom-made__fact {
      grid-template-columns: 1fr;

      gap: 8px;
    }

    #shopify-section-{{ section.id }} .custom-made__fact-value {
      font-size: inherit;
      line-height: 1.65;
    }


    /* ------------------------------------------------------------------------
       Editorial gallery
       ------------------------------------------------------------------------ */

    #shopify-section-{{ section.id }} .custom-made__editorial-gallery {
      grid-template-columns:
        repeat(12, minmax(0, 1fr));

      column-gap: 8px;

      row-gap: 68px;
    }


    /*
     * On garde des compositions franchement différentes.
     * Même les "large" ne remplissent pas tout le viewport.
     */

    #shopify-section-{{ section.id }}
    .custom-made__editorial-item--large.custom-made__editorial-item--left {
      grid-column:
        1 / span 10;
    }

    #shopify-section-{{ section.id }}
    .custom-made__editorial-item--large.custom-made__editorial-item--center {
      grid-column:
        2 / span 10;
    }

    #shopify-section-{{ section.id }}
    .custom-made__editorial-item--large.custom-made__editorial-item--right {
      grid-column:
        3 / span 10;
    }


    #shopify-section-{{ section.id }}
    .custom-made__editorial-item--medium.custom-made__editorial-item--left {
      grid-column:
        1 / span 8;
    }

    #shopify-section-{{ section.id }}
    .custom-made__editorial-item--medium.custom-made__editorial-item--center {
      grid-column:
        3 / span 8;
    }

    #shopify-section-{{ section.id }}
    .custom-made__editorial-item--medium.custom-made__editorial-item--right {
      grid-column:
        5 / span 8;
    }


    #shopify-section-{{ section.id }}
    .custom-made__editorial-item--small.custom-made__editorial-item--left {
      grid-column:
        1 / span 6;
    }

    #shopify-section-{{ section.id }}
    .custom-made__editorial-item--small.custom-made__editorial-item--center {
      grid-column:
        4 / span 6;
    }

    #shopify-section-{{ section.id }}
    .custom-made__editorial-item--small.custom-made__editorial-item--right {
      grid-column:
        7 / span 6;
    }


    /*
     * Décalages irréguliers pour éviter l'effet liste.
     */
    #shopify-section-{{ section.id }}
    .custom-made__editorial-item:nth-child(2n) {
      margin-top: 26px;
    }

    #shopify-section-{{ section.id }}
    .custom-made__editorial-item:nth-child(3n) {
      margin-top: 0;
    }

    #shopify-section-{{ section.id }}
    .custom-made__editorial-item:nth-child(4n) {
      transform:
        translateY(-18px);
    }


    #shopify-section-{{ section.id }} .custom-made__editorial-image {
      max-height:
        calc(
          100svh -
          var(--header-height, 80px) -
          40px
        );
    }

    #shopify-section-{{ section.id }} .custom-made__manifesto {
      margin-top: 90px;
    }


    /* ------------------------------------------------------------------------
       Process
       ------------------------------------------------------------------------ */

    #shopify-section-{{ section.id }} .custom-made__step {
      grid-template-columns:
        38px
        minmax(0, 1fr);

      gap: 14px;

      padding-block: 28px;
    }


    /* ------------------------------------------------------------------------
       Special
       ------------------------------------------------------------------------ */

    #shopify-section-{{ section.id }} .custom-made__special {
      padding:
        38px
        26px;
    }


    /* ------------------------------------------------------------------------
       Expertise
       ------------------------------------------------------------------------ */

    #shopify-section-{{ section.id }} .custom-made__expertise-head {
      grid-template-columns: 1fr;

      gap: 24px;

      margin-bottom: 38px;
    }

    #shopify-section-{{ section.id }} .custom-made__expertise-intro {
      margin-left: 0;
    }

    #shopify-section-{{ section.id }} .custom-made__expertise-grid {
      grid-template-columns:
        repeat(2, minmax(0, 1fr));

      gap:
        38px
        12px;
    }

    #shopify-section-{{ section.id }} .custom-made__expertise-media {
      max-height: none;
    }

    #shopify-section-{{ section.id }} .custom-made__expertise-card-heading {
      font-size:
        clamp(1.2rem, 5vw, 1.7rem);
    }


    /* ------------------------------------------------------------------------
       CTA
       ------------------------------------------------------------------------ */

    #shopify-section-{{ section.id }} .custom-made__cta {
      min-height: 480px;

      padding:
        60px
        24px;
    }

  }
{% endstyle %}



<div class="color-{{ section.settings.color_scheme }} gradient">

  <div
    class="
      custom-made
      container
      {{ section.settings.section_width }}
      js-animation-fade-in
    "
  >

    <div class="custom-made__container">


      {%- comment -%}
        ================================================================
        INTRO
        ================================================================
      {%- endcomment -%}

      <section class="custom-made__intro">

        <div class="custom-made__intro-main">

          {% if section.settings.intro_eyebrow != blank %}

            <p class="custom-made__eyebrow">
              {{ section.settings.intro_eyebrow }}
            </p>

          {% endif %}


          {% if section.settings.intro_heading != blank %}

            <h2 class="custom-made__intro-heading {{ section.settings.intro_heading_size }}">
              {{ section.settings.intro_heading }}
            </h2>

          {% endif %}


          {% if section.settings.intro_text != blank %}

            <div class="custom-made__intro-text custom-made__richtext rte">
              {{ section.settings.intro_text }}
            </div>

          {% endif %}


          {% if section.settings.intro_button_label != blank %}

            <div class="custom-made__intro-button">

              {% render 'button',
                type: 'link',
                class: 'button',
                button_style: section.settings.intro_button_style,
                value: section.settings.intro_button_label,
                href: section.settings.intro_button_link
              %}

            </div>

          {% endif %}

        </div>


        {% if fact_blocks.size > 0 %}

          <div class="custom-made__facts">

            {% for block in fact_blocks %}

              <div
                class="custom-made__fact"
                {{ block.shopify_attributes }}
              >

                {% if block.settings.label != blank %}

                  <span class="custom-made__fact-label">
                    {{ block.settings.label }}
                  </span>

                {% endif %}


                {% if block.settings.value != blank %}

                  <span class="custom-made__fact-value">
                    {{ block.settings.value }}
                  </span>

                {% endif %}

              </div>

            {% endfor %}

          </div>

        {% endif %}

      </section>



      {%- comment -%}
        ================================================================
        EDITORIAL GALLERY
        ================================================================
      {%- endcomment -%}

      {% if editorial_image_blocks.size > 0 %}

        <section class="custom-made__editorial">

