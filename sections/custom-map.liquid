{% liquid
  assign default_address_query = shop.address.address1 | append: ',' | append: shop.address.city | append: ' ' | append: shop.address.province
  assign address = section.settings.address_query | default: default_address_query
%}

{% style %}
  #shopify-section-{{ section.id }} {
    --contact-map-radius: {{ section.settings.border_radius | divided_by: 10 }}rem;

    --contact-map-spacing-top:
      calc(var(--section-spacing-unit-size) * {{ section.settings.spacing_top }});

    --contact-map-spacing-bottom:
      calc(var(--section-spacing-unit-size) * {{ section.settings.spacing_bottom }});

    --contact-map-header-height: var(--header-height, 0px);
  }

  #shopify-section-{{ section.id }} > div {
    padding-block-start: var(--contact-map-spacing-top);
    padding-block-end: var(--contact-map-spacing-bottom);
  }


  /* ==========================================================================
     LAYOUT
     ========================================================================== */

  #shopify-section-{{ section.id }} .contact-map {
    display: grid;
    grid-template-columns: minmax(0, 1.4fr) minmax(380px, 1fr);
    align-items: start;
    width: 100%;
  }


  /* ==========================================================================
     MAP
     ========================================================================== */

  #shopify-section-{{ section.id }} .contact-map__map-column {
    position: relative;
    height: 100%;
    min-width: 0;
  }

  #shopify-section-{{ section.id }} .contact-map__map-sticky {
    position: sticky;

    top: calc(
      var(--contact-map-header-height) +
      var(--contact-map-spacing-top)
    );

    height: calc(
      100vh -
      var(--contact-map-header-height) -
      var(--contact-map-spacing-top) -
      var(--contact-map-spacing-bottom)
    );

    min-height: 500px;
  }

  #shopify-section-{{ section.id }} .contact-map__map-sticky iframe {
    display: block;
    width: 100%;
    height: 100%;
    border: 0;
    border-radius: var(--contact-map-radius);
  }


  /* ==========================================================================
     CONTENT
     ========================================================================== */

  #shopify-section-{{ section.id }} .contact-map__content {
    display: flex;
    flex-direction: column;
    justify-content: center;

    min-height: 120vh;

    padding:
      clamp(64px, 8vw, 140px)
      clamp(32px, 6vw, 100px);
  }

  #shopify-section-{{ section.id }} .contact-map__inner {
    width: 100%;
    max-width: 520px;
    margin-inline: auto;
  }


  /* ==========================================================================
     HEADING
     ========================================================================== */

  #shopify-section-{{ section.id }} .contact-map__eyebrow {
    margin: 0 0 16px;
    opacity: 0.55;
  }

  #shopify-section-{{ section.id }} .contact-map__title {
    margin: 0 0 clamp(56px, 7vw, 100px);
  }


  /* ==========================================================================
     INFORMATION BLOCKS
     ========================================================================== */

  #shopify-section-{{ section.id }} .contact-map__block {
    padding-block: clamp(32px, 4vw, 56px);
    border-top: 1px solid rgba(var(--color-foreground), 0.18);
  }

  #shopify-section-{{ section.id }} .contact-map__block:last-of-type {
    border-bottom: 1px solid rgba(var(--color-foreground), 0.18);
  }

  #shopify-section-{{ section.id }} .contact-map__block-title {
    margin: 0 0 20px;
  }

  #shopify-section-{{ section.id }} .contact-map__text {
    opacity: 0.7;
  }

  #shopify-section-{{ section.id }} .contact-map__text p {
    margin-top: 0;
    margin-bottom: 8px;
  }

  #shopify-section-{{ section.id }} .contact-map__text p:last-child {
    margin-bottom: 0;
  }

  #shopify-section-{{ section.id }} .contact-map__text a {
    color: inherit;
    text-underline-offset: 4px;
  }


  /* ==========================================================================
     BUTTON
     ========================================================================== */

  #shopify-section-{{ section.id }} .contact-map__button-wrapper {
    margin-top: clamp(48px, 6vw, 80px);
  }


  /* ==========================================================================
     TABLET / MOBILE
     ========================================================================== */

  @media screen and (max-width: 989px) {
    #shopify-section-{{ section.id }} .contact-map {
      grid-template-columns: 1fr;
    }

    #shopify-section-{{ section.id }} .contact-map__map-sticky {
      position: relative;
      top: auto;

      height: 60vh;
      min-height: 420px;
    }

    #shopify-section-{{ section.id }} .contact-map__content {
      min-height: auto;

      padding:
        clamp(56px, 10vw, 90px)
        clamp(20px, 6vw, 48px);
    }

    #shopify-section-{{ section.id }} .contact-map__inner {
      max-width: none;
    }

    #shopify-section-{{ section.id }} .contact-map__title {
      margin-bottom: 56px;
    }
  }
{% endstyle %}

<div class="color-{{ section.settings.color_scheme }} gradient">

  <div class="container {{ section.settings.section_width }}">

    <div class="contact-map">

      {% if section.settings.api_key != blank %}
        <div class="contact-map__map-column">

          <div class="contact-map__map-sticky">

            <iframe
              loading="lazy"
              allowfullscreen
              referrerpolicy="no-referrer-when-downgrade"
              title="{{ section.settings.map_title | escape }}"
              src="https://www.google.com/maps/embed/v1/place?key={{ section.settings.api_key }}&q={{ address | url_encode }}&zoom={{ section.settings.zoom_level }}"
            >
            </iframe>

          </div>

        </div>
      {% endif %}


      <div class="contact-map__content">

        <div class="contact-map__inner">

          {% if section.settings.eyebrow != blank %}
            <div class="contact-map__eyebrow">
              {{ section.settings.eyebrow }}
            </div>
          {% endif %}


          {% if section.settings.heading != blank %}
            <h1 class="contact-map__title {{ section.settings.heading_size }}">
              {{ section.settings.heading }}
            </h1>
          {% endif %}


          {% for block in section.blocks %}

            <div
              class="contact-map__block"
              {{ block.shopify_attributes }}
            >

              {% if block.settings.heading != blank %}
                <h2 class="contact-map__block-title {{ block.settings.heading_size }}">
                  {{ block.settings.heading }}
                </h2>
              {% endif %}


              {% if block.settings.text != blank %}
                <div class="contact-map__text rte">
                  {{ block.settings.text }}
                </div>
              {% endif %}

            </div>

          {% endfor %}


          {% if section.settings.button_label != blank %}

            <div class="contact-map__button-wrapper">

              {% render 'button',
                type: 'link',
                class: 'button contact-map__button',
                button_style: section.settings.button_style,
                value: section.settings.button_label,
                href: section.settings.button_link
              %}

            </div>

          {% endif %}

        </div>

      </div>

    </div>

  </div>

</div>


{% schema %}
{
  "name": "Contact + map",
  "tag": "section",

  "settings": [
    {
      "type": "header",
      "content": "Map"
    },
    {
      "type": "textarea",
      "id": "api_key",
      "label": "t:sections.map.settings.api_key.label",
      "info": "t:sections.map.settings.api_key.info"
